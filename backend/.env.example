NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:5173

MONGO_URI=mongodb://127.0.0.1:27017/billing

# ---------------------------------------------------------------- auth ---
# Session signing. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
OTP_SECRET=
AUTH_SESSION_DAYS=7

OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
# Dev only: returns the code in the API response so you can log in without
# MSG91 credentials. Never true in production.
OTP_DEBUG_RETURN_OTP=false

# WhatsApp OTP delivery (MSG91). Required unless OTP_DEBUG_RETURN_OTP=true.
MSG91_AUTH_KEY=
MSG91_INTEGRATED_NUMBER=
MSG91_TEMPLATE_NAME=
MSG91_TEMPLATE_NAMESPACE=
MSG91_TEMPLATE_LANGUAGE_CODE=en
MSG91_TEMPLATE_LANGUAGE_POLICY=deterministic
# Only for templates with a copy-code button; defaults to the OTP itself.
MSG91_TEMPLATE_BUTTON_VALUE=

# Cloudflare R2 (S3-compatible). Create an API token with Object Read & Write.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=billing-bills
# Optional: set only if the bucket is served from a public domain.
R2_PUBLIC_BASE_URL=

UPLOAD_MAX_BYTES=20971520
